# ─────────────────────────────────────────────────────────────
# Folio — environment template. Copy to .env and fill in.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Local database: a PGlite directory (Postgres in WASM, no server needed).
# In production set a postgres:// URL instead — same schema, same SQL.
DATABASE_URL="file:.data/pglite"

# Public site URL — used for canonical URLs, sitemap and OG metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# GitHub integration (server-side only; never exposed to the client).
# A fine-grained, read-only public-repo token raises the rate limit from
# 60 to 5,000 requests/hour. Optional.
GITHUB_USERNAME="israeli-dev"
GITHUB_TOKEN=""

# Optional: overrides the featured owner account created by `npm run db:seed`.
# The seeded account owns the editorial portfolio at "/" and can access /admin.
SEED_OWNER_EMAIL="owner@folio.local"
SEED_OWNER_PASSWORD="change-me-please"
SEED_OWNER_NAME="Israel Kolawole"

# Optional transactional email for password resets and contact notifications.
# When unset, reset links are surfaced in the development UI and messages are
# stored in the database inbox instead of being emailed.
RESEND_API_KEY=""
# Sender shown on outbound mail. Resend requires a verified domain; the shared
# onboarding address works for testing only.
EMAIL_FROM="Folio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=""
