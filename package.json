{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/db/seed.ts",
    "db:schema": "tsx scripts/apply-schema.ts",
    "setup": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\" && tsx src/db/seed.ts",
    "sync:github": "tsx scripts/sync-github.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "dotenv": "^18.0.10",
    "geist": "^1.3.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "postgres": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
